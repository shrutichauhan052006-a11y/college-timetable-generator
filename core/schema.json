{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "College Timetable Problem Data", "type": "object",
  "required": ["schema_version", "subjects", "teachers", "classes", "rooms", "time"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "name", "kind", "session_length"], "properties": {"code": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "kind": {"enum": ["theory", "lab"]}, "session_length": {"type": "integer", "minimum": 1}}}},
    "teachers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "qualified_subjects", "max_weekly_load"], "properties": {"name": {"type": "string", "minLength": 1}, "qualified_subjects": {"type": "array", "items": {"type": "string"}}, "max_weekly_load": {"type": "integer", "minimum": 0}, "unavailable_slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}}, "preferred_slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}}}}},
    "classes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "strength", "subject_periods", "lunch_period"], "properties": {"name": {"type": "string", "minLength": 1}, "strength": {"type": "integer", "minimum": 1}, "subject_periods": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "lunch_period": {"type": "integer", "minimum": 0}}}},
    "rooms": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "capacity", "kind"], "properties": {"name": {"type": "string", "minLength": 1}, "capacity": {"type": "integer", "minimum": 1}, "kind": {"enum": ["classroom", "lab"]}}}},
    "time": {"type": "object", "required": ["working_days", "periods_per_day"], "properties": {"working_days": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "periods_per_day": {"type": "integer", "minimum": 1}, "break_slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}}}},
    "soft_weights": {"type": "object", "properties": {"S1": {"type": "integer", "minimum": 0}, "S2": {"type": "integer", "minimum": 0}, "S3": {"type": "integer", "minimum": 0}, "S4": {"type": "integer", "minimum": 0}, "S5": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
  },
  "$defs": {"slot": {"type": "object", "required": ["day", "period"], "properties": {"day": {"type": "string"}, "period": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}
}
